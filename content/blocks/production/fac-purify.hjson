{
    "type": "GenericCrafter",
    "name": "提纯设施",         // 游戏内显示的名称
    "description": "将石英砂烧炼成玻璃",     // 建筑描述
    "size": 2,                              // 建筑尺寸，3x3
    "rotate": "false",

    "itemCapacity": 10,

    // --- 建造需求 ---
    "requirements": [
        "copper/100",
        "lead/80"        // 用你模组里的材料或原版材料
    ],
    "category": "crafting",                 // 在“制造”分类下
    "research": "fac-Ionization",              // 科技树前置

    // --- 生产效率 ---
    "craftTime": 150,                        // 每生产一轮所需时间（单位：tick，60 tick = 1秒）

    // --- 消耗配置 (只消耗电力) ---
    "consumes": {
        "items": [
            { "item": "tuberculosis", "amount": 5 }
        ],
        "power": 1.8
    },
    // --- 产出配置 (产出两种液体) ---
    "outputItems": [
        {"item": "aurum", "amount": 2},
        {"item": "palladium", "amount": 1}
    ],
    
    // 定义稳定产出的液体列表 (这里产出水，每次生产输出10单位)
    "outputLiquids": [
        {"liquid": "acid-solution", "amount": 0.3}
    ]
}