{
    "type": "GenericCrafter",
    "name": "fac-bioreactor",         // 游戏内显示的名称
    "localizedName": "生物反应器",
    "description": "环氧胶与钯反应生产凝胶体",     // 建筑描述
    "size": 3,                              // 建筑尺寸，3x3
    "rotate": "false",

    "hasLiquids": true,
    "itemCapacity": 20,
    "liquidCapacity": 30,

    // --- 建造需求 ---
    "requirements": [
        "copper/100",
        "lead/80"        // 用你模组里的材料或原版材料
    ],
    "category": "crafting",                 // 在“制造”分类下
    "research": "fac-Ionization",              // 科技树前置

    // --- 生产效率 ---
    "craftTime": 96,                        // 每生产一轮所需时间（单位：tick，60 tick = 1秒）

    // --- 消耗配置 (只消耗电力) ---
    "consumes": {
        "items": [
            { "item": "palladium", "amount": 2 }
        ],
        "liquids": [
            { "liquid": "epoxy-glue", "amount": 0.25 },
            { "liquid": "fresh-water", "amount": 0.2 }
        ],
        "power": 3.2
    },
    // --- 产出配置 (产出两种液体) ---
    "outputItems": [
        {
            "item": "palladium-colloid",
            "amount": 1
        }
    ],

    "drawer": [
        // 1. 绘制底座（不旋转）
        {
            "type": "DrawRegion",
            "suffix": "-bottom"
        },
        // 2. 绘制液体（每种液体单独显示，透明度跟随液体储量）
        {
            "type": "DrawLiquidRegion",
            "drawLiquid": "epoxy-glue",
            "suffix": "-liquid-epoxy-glue"
        },
        {
            "type": "DrawLiquidRegion",
            "drawLiquid": "fresh-water",
            "suffix": "-liquid-fresh-water"
        },
        {
            "type": "DrawRegion",
            "suffix": "-rotor",
            "spinSprite": true,
            "rotateSpeed": 2.0
        },
        {
            "type": "DrawRegion",
            "suffix": "-rotor",
            "spinSprite": true,
            "rotateSpeed": -2.0
        },
        // 3. 绘制顶层（不旋转）
        {
            "type": "DrawRegion",
            "suffix": "-top"
        }
    ]
}